{
  "name": "kiumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeChat article layout system: template catalog + block editor + deterministic renderer",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "kiumi": "node --env-file-if-exists=.env packages/cli/src/index.ts",
    "mcp": "node --env-file-if-exists=.env packages/mcp/src/index.ts",
    "dev:server": "node apps/server/src/index.ts",
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "dev": "pnpm --parallel --filter @kiumi/server --filter @kiumi/web dev",
    "serve": "node --env-file-if-exists=.env apps/server/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.7.2"
  }
}
