{
  "name": "kiumi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WeChat article layout system: template catalog + block editor + deterministic renderer",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "kiumi": "node --env-file-if-exists=.env --env-file-if-exists=.env.local packages/cli/src/index.ts",
    "mcp": "node --env-file-if-exists=.env --env-file-if-exists=.env.local packages/mcp/src/index.ts",
    "dev:server": "node apps/server/src/index.ts",
    "test": "node --test packages/*/test/*.test.ts apps/*/test/*.test.ts",
    "dev": "pnpm --parallel --filter @kiumi/server --filter @kiumi/web dev",
    "serve": "node --env-file-if-exists=.env --env-file-if-exists=.env.local apps/server/src/index.ts",
    "build:web": "pnpm --filter @kiumi/web build",
    "deploy": "pnpm build:web && pnpm --filter @kiumi/edge exec wrangler deploy",
    "sync:r2": "pnpm kiumi sync r2 --concurrency 8",
    "d1:schema": "pnpm --filter @kiumi/edge exec wrangler d1 execute kiumi --remote --file=schema.sql"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/PlutoKeating/Kiumi.git"
  }
}
