      "css": ".ds-card{display:flex;flex-direction:column;height:204px;width:160px;background:#fff;border:1px solid #e8e6e1;border-radius:12px;overflow:hidden;cursor:pointer}.ds-card:hover{border-color:var(--color-accent-400,#64867b);box-shadow:0 1px 3px #0000001a}.ds-card:focus-visible{outline:2px solid var(--color-accent-400,#64867b);outline-offset:3px;}.ds-preview{height:132px;flex-shrink:0;background:var(--color-mist-50,#fafaf8);display:grid;place-items:center;color:#66665f;font:12px system-ui}.ds-caption{height:32px;padding:0 8px;font:11px/32px system-ui;color:#66665f}.ds-apply{align-self:flex-end;min-height:32px;margin:0 8px 8px;padding:0 8px;border:1px solid #e5e4df;border-radius:4px;background:#fff;color:var(--color-accent-500,#426c5f);font:11px system-ui}.ds-apply:hover{background:var(--color-mist-100,#f4f3f0)}.ds-apply:focus-visible{outline:2px solid var(--color-accent-400,#64867b);outline-offset:3px;}"
