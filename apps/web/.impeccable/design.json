  "narrative": {
    "northStar": "明亮的磨砂编辑台",
    "overview": "以用户确认的优雅、清爽、对齐、整洁为准：浅色工作区承载低饱和马卡龙分区，磨砂浮层提供操作层次。保持桌面编辑器的紧凑信息密度，用柔和底色、留白与清楚的状态降低视觉压力。\n\n本文记录现有实现。界面字体、配色和圆角服务于编辑器外壳；文章正文、模板与导出内容保留各自排版。以 `src/styles.css` 的主题 tokens、工作台规则及组件源码为准。",
    "keyCharacteristics": [
      "明亮底色与低饱和鼠尾草、薰衣草、蜜桃点缀。",
      "半透明浮层、柔和阴影和清楚的键盘焦点。",
      "桌面多栏布局，正文与编辑器外壳隔离。"
    ],
    "rules": [
      {
        "name": "正文隔离",
        "body": "界面主题不得覆盖文章 HTML 的文字、背景和模板样式，也不得进入导出正文。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 复用浅色表面、鼠尾草强调色和现有圆角层级。",
      "**Do** 为控件保留可见标签、焦点和明确的禁用状态。",
      "**Do** 保持默认跟随、可固定的工具栏行为。"
    ],
    "donts": [
      "**Don't** 将工作台主题写入文章正文或导出 HTML。",
      "**Don't** 将旧蓝色主题重新引入当前工作台。",
      "**Don't** 将桌面工作台擅自改为移动端编辑器。"
    ]
  }
