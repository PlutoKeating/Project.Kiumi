{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiumi",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // One project serves both: the SPA comes from the web build.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API and auth routes must reach the Worker before the SPA fallback.
    "run_worker_first": ["/api/*", "/auth/*", "/assets/*", "/uploads/*"]
  },
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "REPLACE_WITH_BUCKET" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "kiumi", "database_id": "REPLACE_AT_BUILD_TIME" }
  ],
  // Workers VPC: reach the data service over the existing tunnel, with no
  // public hostname. Fill service_id via KIUMI_VPC_SERVICE_ID at build time.
  "vpc_services": [
    { "binding": "KIUMI_DATA", "service_id": "REPLACE_WITH_VPC_SERVICE_ID", "remote": true }
  ],
  "vars": {
    "KIUMI_STRICT_ASSETS": "1",
    "KIUMI_DATA_ORIGIN": "REPLACE_WITH_DATA_ORIGIN"
  },
  "observability": { "enabled": true }
}
