# Local data directory holding catalog/, assets/, documents/, uploads/
KIUMI_DATA_DIR=./data

# Cookie lives in .env.local, not here: docker compose auto-parses .env and
# would treat `$` segments inside a signed cookie as variables.
# .env.local is gitignored; add XIUMI_COOKIE there.

# WeChat official account (only needed for draft sync)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_DEFAULT_THUMB_MEDIA_ID=

# HTTP service
PORT=8787
HOST=127.0.0.1

# Deploy target, only needed by `pnpm deploy`
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=
KIUMI_VPC_SERVICE_ID=
# Optional: public origin of the data service, used when VPC is not available
KIUMI_DATA_ORIGIN=
# Production OIDC provider; configure as Worker secrets.
ID_ISSUER_URL=
ID_CLIENT_ID=
KIUMI_DATA_KEY=
# Optional: OAuth client ids allowed to call /mcp with a bearer token (default kiumi-mcp)
MCP_CLIENT_IDS=
# Site admins (account sub or email, comma separated) who may configure models at /admin
KIUMI_ADMIN_SUBS=
# Default model catalog source (models.dev schema); the admin panel can override it
MODEL_CATALOG_URL=
# Legacy single model, used only until providers are saved in the /admin panel
# (LLM_PROTOCOL: openai-chat | openai-responses | anthropic-messages | google-generative-ai)
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROTOCOL=
# Optional: R2 bucket name for asset mirroring
R2_BUCKET_NAME=
