# Local data directory holding catalog/, assets/, documents/, uploads/
KIUMI_DATA_DIR=./data

# Optional: raw Cookie header for member-only houses.
# Never commit a real value; never paste it into an issue.
XIUMI_COOKIE=

# WeChat official account (only needed for draft sync)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_DEFAULT_THUMB_MEDIA_ID=

# HTTP service
PORT=8787
HOST=127.0.0.1
